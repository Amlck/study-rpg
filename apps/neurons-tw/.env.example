# neurons-tw cloud sync (R2-only, no Supabase dual-write path).
# Real values live in .env.local (gitignored). GH Actions deploy reads
# these via repo Secrets.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Toggle cloud sync engine without rebuilding (default true). Set false to
# fully disable sync (sign-in UI is hidden, engine no-ops).
VITE_CLOUD_SYNC_ENABLED=true

# Debounced auto-push window after IndexedDB writes, milliseconds. 3000–5000
# is the design sweet spot. Lower = more pushes, higher = larger window where
# a tab crash loses progress.
VITE_SYNC_DEBOUNCE_MS=3000

# Cloudflare Worker base URL (auth-bridging presigner for R2). neurons-tw uses
# the prod custom-domain URL by default. Override locally via .env.local when
# running `wrangler dev`.
VITE_SYNC_WORKER_URL=https://api.med-study-rpg.com

# Build-time base path. Production CI sets VITE_DEPLOY_BASE=/neurons/ so the
# bundle's asset paths point at https://med-study-rpg.com/neurons/...
# Local dev leaves this unset (vite serves at /).
# VITE_DEPLOY_BASE=/neurons/
