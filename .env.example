# Root .env.example — env vars for repo-root scripts (bulk-migrate, reconcile-admin).
#
# Copy to .env.local (gitignored) and fill in. NEVER commit secrets.
# Per-app .env.example files at apps/medexam-tw/ and apps/medexam2-hospital-tw/
# cover client build-time env vars.

# Supabase project (study-rpg)
SUPABASE_URL=https://jakdyjxojokyqxeiuukx.supabase.co

# Service-role JWT — gives RLS bypass; needed for scripts that read all users'
# sync rows (bulk-migrate.ts). NEVER ship this in client builds, Workers, or
# CI. Fetch from Supabase dashboard → Project Settings → API → service_role.
# Rotate it after running ad-hoc scripts that needed it.
SUPABASE_SERVICE_ROLE_KEY=

# R2 S3 credentials — for scripts that PUT/GET R2 blobs directly (bulk-migrate.ts).
# Same keys are bound to the Worker as wrangler secrets (R2_S3_ACCESS_KEY_ID +
# R2_S3_SECRET_ACCESS_KEY). Fetch from Cloudflare dashboard → R2 → Manage R2
# API tokens. The script does not use these for normal client sync — only
# for one-off owner-side ops.
R2_S3_ENDPOINT=https://43631a35f33f4132484a6ce024cc502a.r2.cloudflarestorage.com
R2_S3_ACCESS_KEY_ID=
R2_S3_SECRET_ACCESS_KEY=
R2_BUCKET=study-rpg-saves
